# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.spec text eol=lf
*.txt text eol=lf

# Windows scripts (keep CRLF)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.exe binary
*.ico binary
*.png binary
*.jpg binary
*.rpyb binary
*.rpyc binary
*.rpa binary
